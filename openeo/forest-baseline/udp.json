        "dimension": "bands",
        "target": [
          "natural_forest"
        ]
      }
    },
    "loadcollection1": {
      "process_id": "load_collection",
      "arguments": {
        "bands": [
          "MAP"
        ],
        "id": "ESA_WORLDCOVER_10M_2020_V1",
        "spatial_extent": {
          "from_parameter": "spatial_extent"
        },
        "temporal_extent": [
          "2020-01-01",
          "2020-01-02"
        ]
      }
    },
    "dropdimension2": {
      "process_id": "drop_dimension",
      "arguments": {
        "data": {
          "from_node": "loadcollection1"
        },
        "name": "t"
      }
    },
    "resamplecubespatial1": {
      "process_id": "resample_cube_spatial",
