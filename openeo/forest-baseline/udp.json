    "mergecubes1": {
      "process_id": "merge_cubes",
      "arguments": {
        "cube1": {
          "from_node": "renamelabels1"
        },
        "cube2": {
          "from_node": "renamelabels2"
        }
      }
    },
    "loadcollection2": {
      "process_id": "load_collection",
      "arguments": {
        "bands": [
          "map"
        ],
        "id": "CLMS_TCD_PANTROPICAL_10M_YEARLY_V1",
        "spatial_extent": {
          "from_parameter": "spatial_extent"
        },
        "temporal_extent": [
          "2020-01-01",
          "2020-01-02"
        ]
      }
