    "resamplecubespatial2": {
      "process_id": "resample_cube_spatial",
      "arguments": {
        "data": {
          "from_node": "dropdimension3"
        },
        "method": "near",
        "target": {
          "from_node": "dropdimension1"
        }
      }
    },
    "renamelabels3": {
      "process_id": "rename_labels",
      "arguments": {
        "data": {
          "from_node": "resamplecubespatial2"
        },
        "dimension": "bands",
        "target": [
          "tree_cover_density"
        ]
      }
    },
    "mergecubes2": {
      "process_id": "merge_cubes",
      "arguments": {
        "cube1": {
          "from_node": "mergecubes1"
        },
        "cube2": {
          "from_node": "renamelabels3"
        }
      }
    },
    "reducedimension1": {
      "process_id": "reduce_dimension",
      "arguments": {
        "data": {
          "from_node": "mergecubes2"
        },
        "dimension": "bands",
        "reducer": {
          "process_graph": {
            "arrayelement1": {
              "process_id": "array_element",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                },
                "index": 1
              }
            },
            "eq1": {
              "process_id": "eq",
              "arguments": {
                "x": {
                  "from_node": "arrayelement1"
                },
                "y": 10
              }
            },
            "arrayelement2": {
              "process_id": "array_element",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                },
                "index": 2
              }
            },
            "gt1": {
              "process_id": "gt",
              "arguments": {
                "x": {
                  "from_node": "arrayelement2"
                },
                "y": {
                  "from_parameter": "canopy_cover_threshold"
                }
              }
            },
            "and1": {
              "process_id": "and",
              "arguments": {
                "x": {
                  "from_node": "eq1"
                },
                "y": {
                  "from_node": "gt1"
                }
              }
            },
            "arrayelement3": {
              "process_id": "array_element",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                },
                "index": 2
              }
            },
            "lte1": {
              "process_id": "lte",
              "arguments": {
                "x": {
                  "from_node": "arrayelement3"
                },
                "y": 100
              }
            },
            "and2": {
              "process_id": "and",
              "arguments": {
                "x": {
                  "from_node": "and1"
                },
                "y": {
                  "from_node": "lte1"
                }
              }
            },
            "arrayelement4": {
              "process_id": "array_element",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                },
                "index": 0
              }
            },
            "gt2": {
              "process_id": "gt",
              "arguments": {
                "x": {
                  "from_node": "arrayelement4"
                },
                "y": {
                  "from_parameter": "natural_forest_threshold"
                }
              }
            },
            "and3": {
              "process_id": "and",
              "arguments": {
                "x": {
                  "from_node": "and2"
                },
                "y": {
                  "from_node": "gt2"
                }
              },
              "result": true
            }
          }
        }
      }
    },
    "adddimension1": {
      "process_id": "add_dimension",
      "arguments": {
        "data": {
          "from_node": "reducedimension1"
        },
        "label": "B0",
        "name": "bands",
        "type": "bands"
      },
      "result": true
    }
  },
  "id": "forest_baseline",
  "summary": "Construct a natural forest baseline pixel mask for the year 2020. The returned DataCube has a single band named B0. ",
  "description": "Construct a natural forest baseline pixel mask for the year 2020. The returned DataCube has a single band named B0. ",
  "returns": {
    "description": "A pixel mask. 1 = natural forest, 0 = non-forest.",
    "schema": {
      "type": "object",
      "subtype": "datacube"
    }
  },
  "parameters": [
    {
      "name": "spatial_extent",
      "description": "Geometries specified as GeoJSON object.",
      "schema": {
        "type": "object",
        "subtype": "geojson"
      },
      "default": {
        "type": "Polygon",
        "coordinates": [
          [
            [
              31.222952123,
              1.07092790500008
            ],
            [
              31.222952123,
              1.54693730500003
            ],
            [
              30.5503711040001,
              1.54693730500003
            ],
            [
              30.5503711040001,
              1.07092790500008
            ],
            [
              31.222952123,
              1.07092790500008
            ]
          ]
        ]
      },
      "optional": true
    },
    {
      "name": "canopy_cover_threshold",
      "description": "Minimum canopy cover to be considered forest. Units: percent. See collection CLMS_TCD_PANTROPICAL_10M_YEARLY_V1. A value of 10 implies > 10% canopy cover. A value of 20 implies > 20% canopy cover. ",
      "schema": {
        "type": "number"
      },
      "default": 30,
      "optional": true
    },
    {
      "name": "natural_forest_threshold",
      "description": "Minimum likelihood to be considered natural forest. Units: fraction. A value of 0.08 implies > 8% likelihood. ",
      "schema": {
        "type": "number"
      },
      "default": 0.08,
      "optional": true
    },
    {
      "name": "min_connected_area",
      "description": "Minimum connected area to be considered forest. Units: m^2",
      "schema": {
        "type": "number"
      },
      "default": 10000,
      "optional": true
    }
  ]
}